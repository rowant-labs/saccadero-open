# Where things are on your machine. Copy this file to configs/paths.env, edit it, and `source` it.
# Only ROWANT_DATA is needed when you keep the layout below; every other line shows a default.

# One folder for everything this code builds or reads apart from the code itself: the object libraries built
# from the benchmark's download, the three environments, caches and run folders. Allow 20 GB.
export ROWANT_DATA="$HOME/saccadero-data"

# The LIBERO-Pro2.0 evaluation download, unpacked: the folder that holds simulator-source and service-source.
# export ROWANT_BENCHMARK="$ROWANT_DATA/benchmark/LIBERO-Pro-evaluation"

# The folder that holds the benchmark's archive evaluation.zip as downloaded. Needed only to compare its checksum
# with the one registered before the scored runs, and for the test split.
# export ROWANT_BUNDLE="$ROWANT_DATA/benchmark"

# The two depth nets (release files of this repository): colour-long.pt and colour2.pt.
# export ROWANT_NETS="$ROWANT_DATA/nets"

# The interpreters of the three environments that scripts/setup_env.sh builds: the worker (the simulator side of a
# run), the perception server, and the export environment that builds the object libraries (MuJoCo 3.3.2).
# export ROWANT_WORKER_PYTHON="$ROWANT_DATA/venvs/worker/bin/python"
# export ROWANT_SERVER_PYTHON="$ROWANT_DATA/venvs/server/bin/python"
# export ROWANT_EXPORT_PYTHON="$ROWANT_DATA/venvs/export/bin/python"
